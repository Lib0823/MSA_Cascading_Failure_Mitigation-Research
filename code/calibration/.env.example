# 게이트 ①.5 하네스 환경변수 템플릿. 실제 값은 .env 에 두고 커밋하지 않는다.
# 기본값은 docker-compose.yml 에 박혀 있으므로 .env 없이도 돈다.

# DB 는 포트를 발행하지 않고 데이터가 tmpfs 이므로 trust 인증을 쓴다. 비밀번호 항목은 없다.
DB_NAME=
DB_USER=
DB_APP_USER=

# 조건 구분 — 실험군 25 / 대조군 200. runCalibration.py 가 덮어쓴다.
DB_MAX_CONNECTIONS=

# 자원 상한 (코어 수). 호스트 코어 수에 맞춰 조정한다.
DB_CPUS=
APP_CPUS=

# 부하 성형 손잡이
DB_SLEEP_MILLIS=
DB_BURN_ROWS=

# 앱 측 풀 — 넉넉해야 한다. 조이면 H4 가 뒤집힌다.
HIKARI_MAX_POOL_SIZE=
HIKARI_MIN_IDLE=
HIKARI_CONNECTION_TIMEOUT_MS=
